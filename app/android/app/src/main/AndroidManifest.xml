<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The network: the site you configure (HTTP API and WebView) and the comma on your own network (SSH). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Which networks the phone is on (its hotspot, the Wi-Fi), to look for the comma there only. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- No backup and no device-to-device transfer: the session of the site, the SSH key of this phone and the
         tests stay on this phone. Plain HTTP: res/xml/network_security_config.xml. -->
    <application
        android:name=".PerceptionApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Perception">
        <!-- The only exported component: the launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
